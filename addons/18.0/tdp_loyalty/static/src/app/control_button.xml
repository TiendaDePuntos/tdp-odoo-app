<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="tdp_loyalty.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="." position="inside">
            <button class="btn btn-light btn-lg lh-lg" t-on-click="onClickTdpRedeem">
                <i class="fa fa-gift me-1" role="img" aria-label="Validar premio" title="Validar premio"/>
                Validar premio TDP
            </button>
        </xpath>
    </t>
</templates>
